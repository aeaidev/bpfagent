.SH INSTALLATION

To install bpfagent on your system:

.EX
# Build from source
git clone https://github.com/katim/bpfagent.git
cd bpfagent
./scripts/setup.sh
cargo build --release

# Install manually
sudo cp target/x86_64-unknown-linux-gnu/release/bpfagent /usr/local/bin/
sudo mkdir -p /etc
sudo cp bpfagent.conf /etc/bpfagent.conf

# Optional: Copy man page
sudo mkdir -p /usr/local/share/man/man1
sudo cp docs/bpfagent.1 /usr/local/share/man/man1/
sudo mandb
.EE

For package-based installation (when available), use:

.EX
# Debian/Ubuntu (.deb package)
sudo dpkg -i bpfagent_*.deb

# CentOS/RHEL (.rpm package)
sudo rpm -ivh bpfagent-*.rpm
.EE

