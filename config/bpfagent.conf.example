# bpfagent configuration file

# Daemon settings
pid_file = "/tmp/bpfagent.pid"
working_directory = "/"
log_file = "/tmp/bpfagent.log"
# Optional: stats/metrics interval in ms (default 3000)
# stats_interval_ms = 3000

# EBPF programs to load and run
[[ebpf_programs]]
name = "kfree_skb"
enabled = true

[[ebpf_programs]]
name = "sca"
enabled = true

[[ebpf_programs]]
name = "irss"
enabled = true
# Optional: IRSS flow settings (defaults: listen_port 5020, raw_dest 10.10.10.253)
# [ebpf_programs.settings]
# listen_port = 5020
# raw_dest = "10.10.10.253"

[[ebpf_programs]]
name = "iflat"
enabled = false
# Measures interface-to-interface forwarding latency of UDP datagrams (e.g.
# eno1 -> tun0 across nftables NAT) by correlating the first 4 payload bytes.
# Required settings (no defaults; the program stays disabled without them):
# [ebpf_programs.settings]
# rx_iface = "eno1"   # ingress interface (XDP)
# tx_iface = "tun0"   # egress interface (TC clsact egress)

[[ebpf_programs]]
name = "my_program"
enabled = false
# Example plugin from docs/PLUGINS.md: counts openat() calls per PID and
# exports the my_program_events_per_pid gauge. No settings.

[[ebpf_programs]]
name = "uprobe"
enabled = false
# Traces calls + arguments of a userspace function; target and symbol are
# required to actually enable it (no defaults exist)
# [ebpf_programs.settings]
# target = "/path/to/app"   # binary or shared library to instrument
# symbol = "function_name"  # function to trace (ELF symbol)
# offset = 0                # extra byte offset past the symbol
# pid = -1                  # -1 = all processes, or a specific PID
# string_arg = 0            # 1-6: also read this argument as a C string