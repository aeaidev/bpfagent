# bpfagent configuration file

# Daemon settings
pid_file = "/tmp/bpfagent.pid"
working_directory = "/"
log_file = "/tmp/bpfagent.log"

# EBPF programs to load and run
[[ebpf_programs]]
name = "kfree_skb"
enabled = true

[[ebpf_programs]]
name = "sca"
enabled = true

[[ebpf_programs]]
name = "irss"
enabled = true
# Optional: IRSS flow settings (defaults: listen_port 5020, raw_dest 10.10.10.253)
# [ebpf_programs.settings]
# listen_port = 5020
# raw_dest = "10.10.10.253"