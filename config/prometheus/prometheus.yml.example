global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    monitor: 'bpfagent-monitor'

scrape_configs:
  # BPF Agent metrics
  - job_name: 'bpfagent'
    static_configs:
      - targets: ['localhost:9101']
    scrape_interval: 10s
    scrape_timeout: 5s
    
  # Optional: Multiple bpfagent instances
  # - job_name: 'bpfagent-prod'
  #   static_configs:
  #     - targets: ['prod-host:9101']
  #
  # - job_name: 'bpfagent-staging'
  #   static_configs:
  #     - targets: ['staging-host:9101']

# Example alerting rules (optional)
# rule_files:
#   - 'bpfagent_rules.yml'
