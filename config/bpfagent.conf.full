# Full BPF Agent Configuration
# This file demonstrates all available configuration options

# Daemon Settings
# ===============

# Path to PID file (used to track the daemon process)
pid_file = "/var/run/bpfagent.pid"

# Working directory for the daemon process
working_directory = "/"

# Path to log file (used in daemon mode)
log_file = "/var/log/bpfagent.log"

# Interval (milliseconds) driving BPF-map reads, interactive statistics
# printing and Prometheus updates; per-interval averages/deltas cover this
# window (optional, default 3000, must be > 0)
# stats_interval_ms = 3000


# eBPF Programs
# =============
# Configure which eBPF programs to load and run
# If no programs are specified, all registered programs are enabled by default

[[ebpf_programs]]
name = "kfree_skb"
enabled = true
# Traces kernel packet drops at kfree_skb tracepoint

[[ebpf_programs]]
name = "sca"
enabled = true
# Traces socket communication latency per process (NNG protocol)

[[ebpf_programs]]
name = "irss"
enabled = true
# Measures UDP-to-raw-IP forwarding latency (CRYPTO -> IRSS -> MAC data flow)
# Optional program settings (defaults shown):
[ebpf_programs.settings]
# UDP port IRSS listens on (from CRYPTO); the RX filter only timestamps
# datagrams received on this port
listen_port = 5020
# Raw-IP destination of the IRSS data flow (MAC); the TX filter only matches
# sendmsg() calls addressed here
raw_dest = "10.10.10.253"

[[ebpf_programs]]
name = "iflat"
enabled = false
# Measures interface-to-interface forwarding latency of UDP datagrams (e.g.
# eno1 -> tun0) by correlating the first 4 payload bytes, which NAT does not
# rewrite; RX is XDP on rx_iface, TX is a TC clsact egress classifier on
# tx_iface. Required program settings (no defaults; the program stays
# disabled without them):
[ebpf_programs.settings]
# Ingress interface (XDP hook, e.g. eno1)
rx_iface = "eno1"
# Egress interface (TC clsact egress hook, e.g. tun0)
tx_iface = "tun0"

[[ebpf_programs]]
name = "iflat_uprobe"
enabled = false
# Measures a pair of latencies for one UDP/TCP datagram (docs/IFLAT_UPROBE.md):
# 1) ingress on rx1_iface (XDP) -> ingress on rx2_iface (XDP), 2) ingress on
# rx2_iface -> the call of a function receiving the payload as a parameter
# (uprobe). Datagrams are correlated by the first 4 payload bytes. Required
# program settings (no defaults; the program stays disabled without them):
[ebpf_programs.settings]
# First ingress interface (XDP hook, e.g. eno1)
rx1_iface = "eno1"
# Second ingress interface (XDP hook, e.g. tun0)
rx2_iface = "tun0"
# Path of the binary or shared library to instrument
target = "/path/to/app"
# Function symbol receiving the payload (ELF symbol; C++ symbols are mangled,
# e.g. _ZN11FpgaPciePhy11submitBurstE8EndpointR6TxSlot)
symbol = "function_name"
# Extra byte offset past the symbol (optional, default 0)
offset = 0
# PID filter: -1 = all processes, or a specific PID (optional, default -1)
pid = -1
# x86_64 SysV argument register leading to the payload: 1-6 (rdi-r9); for a
# C++ method 1 is the hidden `this` pointer, so the first explicit argument
# is 2 (optional, default 3)
arg_index = 3
# Byte offset of the payload pointer within the struct the argument points
# to, e.g. offsetof(TxSlot, payload) = 296 for `TxSlot &slot` with
# `slot->payload`; -1 = the argument points directly at the payload, no
# pointer chase (optional, default -1)
payload_ptr_offset = -1
# Byte offset from the resolved payload pointer to the first payload byte
# (optional, default 0)
tag_offset = 0

[[ebpf_programs]]
name = "my_program"
enabled = false
# Example plugin from docs/PLUGINS.md: counts openat() calls per PID and
# exports the my_program_events_per_pid gauge. No settings.

[[ebpf_programs]]
name = "uprobe"
enabled = false
# Traces calls to a function in a userspace binary/shared library and
# snapshots its arguments (up to 6 register values, x86_64 SysV ABI)
# Required program settings (no defaults; the program stays disabled
# without target and symbol):
[ebpf_programs.settings]
# Path of the binary or shared library to instrument
target = "/path/to/app"
# Function symbol to trace (ELF symbol; stripped binaries need offset instead)
symbol = "function_name"
# Extra byte offset past the symbol (optional, default 0)
offset = 0
# PID filter: -1 = all processes, or a specific PID (optional, default -1)
pid = -1
# Argument to also read as a C string: 0 = none, 1-6 = argument index
# (optional, default 0)
string_arg = 0


# Usage Notes
# ===========
#
# 1. Default configuration paths (searched in order):
#    - /etc/bpfagent.conf
#    - /etc/bpfagent/bpfagent.conf
#    - /usr/local/etc/bpfagent.conf
#    - /usr/local/etc/bpfagent/bpfagent.conf
#    - ~/.bpfagent.conf
#    - ~/.config/bpfagent/config.toml
#    - ./bpfagent.conf (current directory)
#
# 2. Specify custom config with: bpfagent -f /path/to/config.toml
#
# 3. Command-line options override configuration:
#    - -d, --daemon          Run in daemon mode
#    - -v, --verbose         Enable verbose output
#    - -i, --metrics-ip      Metrics server IP (default: 0.0.0.0)
#    - -p, --metrics-port    Metrics server port (default: 9101)
#
# 4. Metrics endpoint: http://<metrics-ip>:<metrics-port>/metrics
