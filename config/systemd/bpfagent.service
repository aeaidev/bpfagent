[Unit]
Description=BPF Agent - eBPF Program Manager with Prometheus Metrics
Documentation=man:bpfagent(1)
After=network.target

[Service]
Type=simple
User=root
Group=root

# Main executable
# NOTE: run in foreground (no -d) — systemd manages the process itself.
# With -d the agent forks and the parent exits, and systemd then kills
# the real worker process during cgroup cleanup (Type=simple).
ExecStart=/usr/local/bin/bpfagent -f /etc/bpfagent.conf

# Restart on failure
Restart=on-failure
RestartSec=10

# Security restrictions
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log /run /proc /sys

# Resource limits
LimitNOFILE=65536
LimitNPROC=65536

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bpfagent

[Install]
WantedBy=multi-user.target
